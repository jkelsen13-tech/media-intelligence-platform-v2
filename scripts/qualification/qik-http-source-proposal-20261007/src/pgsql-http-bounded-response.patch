+/* Reject truncation at an embedded NUL before any C-string interpretation. */
+static char *
+http_text_to_cstring(text *input)
+{
+	size_t len = VARSIZE_ANY_EXHDR(input);
+	if (len > HTTP_REQUEST_MAX_BYTES || memchr(VARDATA_ANY(input), '\0', len))
+		elog(ERROR, "mip_http_request_text_refused");
+	return text_to_cstring(input);
+}
+
+static bool
+http_ascii_alnum(unsigned char c)
+{
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+	       (c >= '0' && c <= '9');
+}
+
+static bool
+http_request_header_valid(const char *field, const char *value)
+{
+	size_t i, len = strlen(field);
+	if (!len || len > HTTP_HEADER_FIELD_MAX_BYTES)
+		return false;
+	for (i = 0; i < len; i++)
+	{
+		unsigned char c = (unsigned char)field[i];
+		if (!http_ascii_alnum(c) && !strchr("!#$%&'*+-.^_`|~", c))
+			return false;
+	}
+	len = strlen(value);
+	if (len > HTTP_HEADER_VALUE_MAX_BYTES)
+		return false;
+	for (i = 0; i < len; i++)
+		if ((unsigned char)value[i] < 32 || (unsigned char)value[i] > 126)
+			return false;
+	return true;
+}
+
+static bool
+http_optional_header_allowed(const char *field)
+{
+	/* Keep authority, framing, and transport headers under curl/C control. */
+	return strcasecmp(field, "Content-Type") != 0 &&
+	       strcasecmp(field, "Host") != 0 &&
+	       strcasecmp(field, "Content-Length") != 0 &&
+	       strcasecmp(field, "Transfer-Encoding") != 0 &&
+	       strcasecmp(field, "Connection") != 0 &&
+	       strcasecmp(field, "Proxy-Authorization") != 0 &&
+	       strcasecmp(field, "Expect") != 0;
+}
+
+static struct curl_slist *
+http_append_request_header(struct curl_slist *headers, const char *field, const char *value)
+{
+	size_t total_len;
+	size_t bytes, count = 1;
+	char *buffer;
+	struct curl_slist *result;
+	struct curl_slist *item;
+	if (!http_request_header_valid(field, value))
+		elog(ERROR, "mip_http_request_header_refused");
+	total_len = strlen(field) + strlen(value) + 3;
+	bytes = total_len;
+	for (item = headers; item; item = item->next)
+	{
+		size_t item_bytes = strlen(item->data) + 1;
+		if (++count > HTTP_HEADER_MAX_COUNT || item_bytes > HTTP_REQUEST_MAX_BYTES - bytes)
+			elog(ERROR, "mip_http_request_header_refused");
+		bytes += item_bytes;
+	}
+	buffer = palloc(total_len);
+	snprintf(buffer, total_len, "%s: %s", field, value);
+	result = curl_slist_append(headers, buffer);
+	pfree(buffer);
+	if (!result)
+		elog(ERROR, "mip_http_request_header_refused");
+	return result;
+}
+
+static bool
+http_uri_allowed(const char *uri)
+{
+	size_t i, host_start = 8, label_start = 8, path_start, len = strlen(uri);
+	const char *segment;
+	bool host_has_letter = false, host_has_dot = false;
+	if (len > HTTP_URI_MAX_BYTES || len <= host_start || strncmp(uri, "https://", 8) != 0)
+		return false;
+	/* DNS authority only; no userinfo, escapes, literals, or empty labels. */
+	for (i = host_start; i < len && uri[i] != ':' && uri[i] != '/'; i++)
+	{
+		unsigned char c = (unsigned char)uri[i];
+		if (c == '.')
+		{
+			host_has_dot = true;
+			if (i == label_start || i - label_start > 63 || uri[i-1] == '-')
+				return false;
+			label_start = i + 1;
+		}
+		else if (!http_ascii_alnum(c) || (c >= 'A' && c <= 'Z'))
+		{
+			if (c != '-' || i == label_start)
+				return false;
+		}
+		if (c >= 'a' && c <= 'z')
+			host_has_letter = true;
+	}
+	if (i == label_start || i - label_start > 63 || i - host_start > 253 || uri[i-1] == '-' ||
+	    !host_has_letter || !host_has_dot)
+		return false;
+	/* A letter-only DNS suffix also excludes curl's numeric/hex IP forms. */
+	if (i - label_start < 2 ||
+	    (i - label_start == 9 && strncmp(uri + label_start, "localhost", 9) == 0) ||
+	    (i - label_start == 5 && strncmp(uri + label_start, "local", 5) == 0))
+		return false;
+	for (path_start = label_start; path_start < i; path_start++)
+		if (uri[path_start] < 'a' || uri[path_start] > 'z')
+			return false;
+	if (i == len || uri[i] != '/')
+		return false;
+	path_start = ++i;
+	if (strstr(uri + path_start, ".."))
+		return false;
+	segment = uri + path_start;
+	for (; i <= len; i++)
+	{
+		unsigned char c = (unsigned char)uri[i];
+		if (c == '/' || c == '\0')
+		{
+			size_t span = (size_t)(uri + i - segment);
+			if ((!span && c == '/') || (span == 1 && segment[0] == '.') ||
+			    (span == 2 && segment[0] == '.' && segment[1] == '.'))
+				return false;
+			segment = uri + i + 1;
+		}
+		else if (!http_ascii_alnum(c) && !strchr("-._~", c))
+			return false;
+	}
+	return true;
+}
+
+static bool
+http_cainfo_allowed(const char *value)
+{
+	const char *basename;
+	size_t i, len;
+	if (strncmp(value, "/mip/trust/", 11) != 0)
+		return false;
+	basename = value + 11;
+	len = strlen(basename);
+	if (len != 68 || strcmp(basename + 64, ".pem") != 0)
+		return false;
+	for (i = 0; i < 64; i++)
+		if (!((basename[i] >= 'a' && basename[i] <= 'f') || (basename[i] >= '0' && basename[i] <= '9')))
+			return false;
+	return true;
+}
+
+static bool
+http_curlopt_value_valid(const http_curlopt *opt, const char *value, long *number)
+{
+	long maximum;
+	size_t i, len = strlen(value);
+	if (opt->curlopt == CURLOPT_CAINFO && opt->curlopt_type == CURLOPT_STRING)
+		return http_cainfo_allowed(value);
+	if (opt->curlopt_type != CURLOPT_LONG)
+		return false;
+	switch (opt->curlopt)
+	{
+		case CURLOPT_TIMEOUT: maximum = HTTP_TIMEOUT_MAX_MS / 1000; break;
+		case CURLOPT_TIMEOUT_MS: maximum = HTTP_TIMEOUT_MAX_MS; break;
+		case CURLOPT_CONNECTTIMEOUT: maximum = HTTP_CONNECT_TIMEOUT_MAX_MS / 1000; break;
+		case CURLOPT_CONNECTTIMEOUT_MS: maximum = HTTP_CONNECT_TIMEOUT_MAX_MS; break;
+		default: return false;
+	}
+	if (!len || len > 4 || value[0] == '0')
+		return false;
+	*number = 0;
+	for (i = 0; i < len; i++)
+	{
+		if (value[i] < '0' || value[i] > '9')
+			return false;
+		*number = *number * 10 + value[i] - '0';
+	}
+	return *number <= maximum;
+}
+
+static CURLcode
+http_apply_transport_policy(CURL *handle)
+{
+	CURLcode result;
+#define HTTP_POLICY_SET(opt, value) do { \
+	result = curl_easy_setopt(handle, opt, value); \
+	if (result != CURLE_OK) return result; \
+} while (0)
+	HTTP_POLICY_SET(CURLOPT_PROXY, "");
+	HTTP_POLICY_SET(CURLOPT_PRE_PROXY, "");
+	HTTP_POLICY_SET(CURLOPT_SSL_VERIFYPEER, 1L);
+	HTTP_POLICY_SET(CURLOPT_SSL_VERIFYHOST, 2L);
+	HTTP_POLICY_SET(CURLOPT_FOLLOWLOCATION, 0L);
+	HTTP_POLICY_SET(CURLOPT_MAXREDIRS, 0L);
+#if LIBCURL_VERSION_NUM >= 0x075500 /* 7.85.0 */
+	HTTP_POLICY_SET(CURLOPT_PROTOCOLS_STR, "https");
+	HTTP_POLICY_SET(CURLOPT_REDIR_PROTOCOLS_STR, "https");
+#else
+	HTTP_POLICY_SET(CURLOPT_PROTOCOLS, (long)CURLPROTO_HTTPS);
+	HTTP_POLICY_SET(CURLOPT_REDIR_PROTOCOLS, (long)CURLPROTO_HTTPS);
+#endif
+#undef HTTP_POLICY_SET
+	return CURLE_OK;
 }
 
