 	StringInfo si = (StringInfo)userp;
+	/* Audit responses are minimal. Bound each header/body buffer to 64KiB. */
+	const size_t max_response_bytes = 64 * 1024;
+	size_t realsize;
+	if ( size && nmemb > max_response_bytes / size )
+		return 0;
